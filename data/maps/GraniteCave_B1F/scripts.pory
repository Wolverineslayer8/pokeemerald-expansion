script GraniteCave_EventScript_Tobin{
    trainerbattle_single(TRAINER_TOBIN, Tobin_Intro, Tobin_Outro)
    msgbox(PostBattle_Tobin, MSGBOX_AUTOCLOSE)
    waitmessage
    end

}

text Tobin_Intro{
    format("I feel a cold draft coming from the stairs. Good thing my pokemon are here to keep me warm!")
}

text Tobin_Outro{
    format("You're really strong! You shouldn't have any problems ahead.")
}

text PostBattle_Tobin{
    format("Feel free to keep warm by my Slugma before moving on!")
}